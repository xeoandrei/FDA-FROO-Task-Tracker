# ==============================================================================
# FDA FIELD REGULATORY OPERATIONS OFFICE (FROO) TASK TRACKER
# Local Environment Configuration (.env.example)
# ==============================================================================

# Database Configuration (Docker container "froo-mysql" / MySQL Workbench)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=froo_user
DB_PASSWORD=froo_password_secret
DB_NAME=froo_db

# Express API Port
API_PORT=4000

# JSON Web Token Authentication
JWT_SECRET=froo_fda_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Frontend API URL (Vite environment variable)
VITE_API_BASE_URL=http://localhost:4000

# ==============================================================================
# EMAIL NOTIFICATIONS CONFIGURATION (oddgfroo@fda.gov.ph)
# ==============================================================================
GMAIL_SENDER_EMAIL=oddgfroo@fda.gov.ph
GMAIL_SENDER_NAME="FDA ODDG-FROO Task Tracker"
APP_BASE_URL=

# OPTION A (Recommended - 2-Minute Setup, Zero Cloud Console Hassle):
# Paste the Web App URL from Google Apps Script logged into oddgfroo@fda.gov.ph
GMAIL_WEBHOOK_URL=
GMAIL_WEBHOOK_SECRET=froo_email_secret_2026

# OPTION B (Alternative - Direct Gmail OAuth2 REST API):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

